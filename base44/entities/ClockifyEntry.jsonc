{
  "name": "ClockifyEntry",
  "type": "object",
  "properties": {
    "client": {
      "type": "string"
    },
    "matter": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "day": {
      "type": "string"
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "email": {
      "type": "string"
    },
    "import_key": {
      "type": "string"
    }
  },
  "required": [
    "client",
    "matter",
    "day",
    "seconds",
    "email",
    "import_key"
  ],
  "rls": {
    "create": false,
    "read": {
      "data.email": "{{user.email}}"
    },
    "update": false,
    "delete": false
  }
}
