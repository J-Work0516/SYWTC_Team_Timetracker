{
  "name": "ClockifyEntry",
  "type": "object",
  "properties": {
    "client": {
      "type": "string"
    },
    "matter": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "day": {
      "type": "string"
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "email": {
      "type": "string"
    },
    "import_key": {
      "type": "string"
    }
  },
  "required": ["client", "matter", "day", "seconds", "email", "import_key"],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
