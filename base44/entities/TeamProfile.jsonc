{
  "name": "TeamProfile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "job_role": {
      "type": "string"
    },
    "work_location": {
      "type": "string",
      "enum": [
        "",
        "US",
        "Outside US"
      ]
    },
    "salary": {
      "type": "number",
      "minimum": 0
    },
    "target": {
      "type": "number",
      "minimum": 1
    },
    "cost_basis": {
      "type": "number",
      "minimum": 1
    },
    "access_level": {
      "type": "string",
      "enum": [
        "Employee",
        "Team Manager",
        "Full Admin"
      ]
    },
    "manager_email": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "name",
    "job_role",
    "target",
    "cost_basis"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
