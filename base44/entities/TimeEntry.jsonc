{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "client": {
      "type": "string"
    },
    "matter": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "day": {
      "type": "string",
      "format": "date"
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "enum": [
        "timer",
        "manual"
      ]
    },
    "stopped_at": {
      "type": "string"
    }
  },
  "required": [
    "client",
    "matter",
    "description",
    "kind",
    "day"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": false
  }
}
